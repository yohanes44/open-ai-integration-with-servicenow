	//When an assistant is set to false, all intents within the assistant will also be set to false

	if(current.active == false){
		var intentGr = new GlideRecord("x_edpet_open_ai_intent");
		intentGr.addQuery("assistant", current.sys_id);
		intentGr.query();
		while(intentGr.next()){
			intentGr.setValue("active", false);
			intentGr.update();	
		}
	}


